<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_navigation"
    android:orientation="vertical"
    android:padding="@dimen/cms_spacing_xl">

    <!-- Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/cms_spacing_lg"
        android:background="@drawable/bg_status_badge" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WORKSPACE &amp; PROJECTS"
        android:textAppearance="@style/TextAppearance.CMS.Caption"
        android:textColor="@color/cms_accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Switch Active Project"
        android:textAppearance="@style/TextAppearance.CMS.Title" />

    <!-- Current Company Indicator -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.CMS.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:layout_marginBottom="@dimen/cms_spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/cms_spacing_card">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Company"
                android:src="@drawable/ic_building"
                app:tint="@color/cms_accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cms_spacing_md"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvActiveCompanyName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CMS.Body"
                    android:textColor="@color/cms_text_primary"
                    android:textStyle="bold"
                    tools:text="Apex Infra Ltd" />

                <TextView
                    android:id="@+id/tvActiveCompanyRole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CMS.Caption"
                    android:textColor="@color/cms_text_secondary"
                    tools:text="Primary Workspace" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="@dimen/cms_spacing_sm"
                android:paddingVertical="2dp"
                android:text="ACTIVE ORG"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_accent"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/cms_spacing_sm"
        android:text="ASSIGNED PROJECTS"
        android:textAppearance="@style/TextAppearance.CMS.Caption"
        android:textColor="@color/cms_text_secondary" />

    <!-- Projects List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvWorkspaceProjects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="320dp"
        android:nestedScrollingEnabled="false"
        tools:itemCount="3"
        tools:listitem="@layout/item_workspace_project" />

    <TextView
        android:id="@+id/tvEmptyProjects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/cms_spacing_lg"
        android:gravity="center"
        android:text="No assigned projects found in this workspace."
        android:textAppearance="@style/TextAppearance.CMS.Caption"
        android:textColor="@color/cms_text_tertiary"
        android:visibility="gone" />

</LinearLayout>
