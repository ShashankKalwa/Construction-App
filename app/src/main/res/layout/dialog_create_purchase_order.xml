<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cms_spacing_lg">

        <!-- Handle Bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/cms_spacing_md"
            android:background="@color/cms_border" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Purchase Order (PO)"
            android:textAppearance="@style/TextAppearance.CMS.Title" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Issues procurement commitment to vendor without immediate cash outflow"
            android:textAppearance="@style/TextAppearance.CMS.Caption"
            android:textColor="@color/cms_text_tertiary" />

        <!-- Vendor Selection -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilVendor"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_md"
            android:hint="Select Approved Vendor *">

            <AutoCompleteTextView
                android:id="@+id/actvVendor"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- PO Number & Delivery Date -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_md"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilPoNumber"
                style="@style/Widget.CMS.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="PO Number (Optional)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etPoNumber"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:textColor="@color/cms_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="@dimen/cms_spacing_sm"
                android:layout_height="1dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilDeliveryDate"
                style="@style/Widget.CMS.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Expected Delivery *">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etDeliveryDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="date"
                    android:textColor="@color/cms_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Line Item Header -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_md"
            android:text="MATERIAL LINE ITEM"
            android:textAppearance="@style/TextAppearance.CMS.Caption"
            android:textColor="@color/cms_accent" />

        <!-- Item Description -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilItemDescription"
            style="@style/Widget.CMS.TextInputLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Item Description *">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etItemDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapSentences"
                android:text="OPC 53 Grade Cement Bags"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Qty & Unit (Side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilQuantity"
                style="@style/Widget.CMS.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Quantity *">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="500"
                    android:textColor="@color/cms_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="@dimen/cms_spacing_sm"
                android:layout_height="1dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUnit"
                style="@style/Widget.CMS.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Unit (e.g. BAGS, MT)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUnit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:text="BAGS"
                    android:textColor="@color/cms_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Unit Price & Material ID (Side by side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:orientation="horizontal">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilUnitPrice"
                style="@style/Widget.CMS.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Unit Price (INR) *">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etUnitPrice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="numberDecimal"
                    android:text="380.00"
                    android:textColor="@color/cms_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <View
                android:layout_width="@dimen/cms_spacing_sm"
                android:layout_height="1dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilMaterialCode"
                style="@style/Widget.CMS.TextInputLayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="Material ID">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMaterialCode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textCapCharacters"
                    android:text="mat_cem_opc"
                    android:textColor="@color/cms_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>
        </LinearLayout>

        <!-- Live Financial Preview Box -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_md"
            app:cardBackgroundColor="@color/cms_card"
            app:strokeColor="@color/cms_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/cms_spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Subtotal:"
                        android:textAppearance="@style/TextAppearance.CMS.BodySecondary"
                        android:textColor="@color/cms_text_secondary" />

                    <TextView
                        android:id="@+id/tvPreviewSubtotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CMS.Body"
                        android:textColor="@color/cms_text_primary"
                        tools:text="₹1,90,000" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="6dp"
                    android:background="@color/cms_divider" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Total PO Commitment:"
                        android:textAppearance="@style/TextAppearance.CMS.Title"
                        android:textColor="@color/cms_text_primary" />

                    <TextView
                        android:id="@+id/tvPreviewTotal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CMS.Title"
                        android:textColor="@color/cms_accent"
                        tools:text="₹1,90,000" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_lg"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textColor="@color/cms_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitPo"
                style="@style/Widget.CMS.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cms_spacing_sm"
                android:text="Issue Purchase Order" />
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
