<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:padding="@dimen/cms_spacing_lg">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/cms_spacing_md"
        android:background="@color/cms_border" />

    <TextView
        android:id="@+id/tvDialogTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Review Material Requisition"
        android:textAppearance="@style/TextAppearance.CMS.Title" />

    <!-- Request Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        style="@style/Widget.CMS.Card.Elevated">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/cms_spacing_md">

            <TextView
                android:id="@+id/tvRequestDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CMS.Headline"
                tools:text="150.00 Bags of OPC 53 Cement" />

            <TextView
                android:id="@+id/tvRequestMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                tools:text="Requested by: Amit Patel • Required: 26 Mar 2026" />

            <TextView
                android:id="@+id/tvRequestPhase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.CMS.BodySecondary"
                tools:text="Column M25 casting pour" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Dual Control Notice -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:background="@drawable/bg_status_badge"
        android:backgroundTint="@color/cms_warning_tint"
        android:orientation="horizontal"
        android:padding="@dimen/cms_spacing_sm">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_marginEnd="@dimen/cms_spacing_sm"
            android:src="@drawable/ic_warning"
            app:tint="@color/cms_warning" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Dual-Control Policy: Submitter cannot approve their own requisition. Must be reviewed by an authorized PM."
            android:textAppearance="@style/TextAppearance.CMS.Caption"
            android:textColor="@color/cms_warning" />
    </LinearLayout>

    <!-- Optional / Rejection Reason Input -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReason"
        style="@style/Widget.CMS.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:hint="Rejection Reason (required if rejecting)">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:lines="2"
            android:textColor="@color/cms_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_lg"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnReject"
            style="@style/Widget.CMS.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/cms_spacing_sm"
            android:layout_weight="1"
            android:strokeColor="@color/cms_error"
            android:text="Reject"
            android:textColor="@color/cms_error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApprove"
            style="@style/Widget.CMS.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Approve" />
    </LinearLayout>

</LinearLayout>

