<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/cms_spacing_lg"
    android:paddingTop="@dimen/cms_spacing_md"
    android:paddingBottom="@dimen/cms_spacing_xxl">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/cms_spacing_md"
        android:background="@drawable/bg_skeleton_pill" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Console Role Credentials"
        android:textAppearance="@style/TextAppearance.CMS.Headline" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Tap any role below to prefill credentials and sign in"
        android:textAppearance="@style/TextAppearance.CMS.BodySecondary" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvRoleCredentials"
        android:layout_width="match_parent"
        android:layout_height="380dp"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:clipToPadding="false" />

</LinearLayout>
