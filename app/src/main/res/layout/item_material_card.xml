<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMaterial"
    style="@style/Widget.CMS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cms_spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cms_spacing_card">

        <!-- Header: Code + Low Stock Warning Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMaterialCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="@dimen/cms_spacing_sm"
                android:paddingVertical="@dimen/cms_spacing_xs"
                android:textAppearance="@style/TextAppearance.CMS.Mono"
                tools:text="MAT-STEEL-12" />

            <TextView
                android:id="@+id/tvMaterialCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cms_spacing_sm"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_tertiary"
                tools:text="STEEL" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvLowStockBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/cms_warning_tint"
                android:paddingHorizontal="@dimen/cms_spacing_sm"
                android:paddingVertical="2dp"
                android:text="LOW STOCK"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_warning"
                android:textStyle="bold"
                android:visibility="visible"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Name -->
        <TextView
            android:id="@+id/tvMaterialName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:textAppearance="@style/TextAppearance.CMS.Title"
            tools:text="12mm TMT Fe550D Rebar" />

        <!-- Stock Level & Unit Cost -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current Stock"
                    android:textAppearance="@style/TextAppearance.CMS.Caption"
                    android:textColor="@color/cms_text_secondary" />

                <TextView
                    android:id="@+id/tvCurrentStock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CMS.Headline"
                    android:textColor="@color/cms_text_primary"
                    tools:text="3.50 MT" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvMinThreshold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CMS.Caption"
                    android:textColor="@color/cms_text_tertiary"
                    tools:text="Min: 6.00 MT" />

                <TextView
                    android:id="@+id/tvUnitCost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CMS.Caption"
                    android:textColor="@color/cms_text_secondary"
                    tools:text="Rate: ₹66,000 / MT" />
            </LinearLayout>
        </LinearLayout>

        <!-- Action Row: Adjust / Issue to Site -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_md"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnIssueStock"
                style="@style/Widget.CMS.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginEnd="@dimen/cms_spacing_sm"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="@dimen/cms_spacing_md"
                android:text="Issue to Site"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAdjustStock"
                style="@style/Widget.CMS.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="@dimen/cms_spacing_md"
                android:text="Adjust"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
