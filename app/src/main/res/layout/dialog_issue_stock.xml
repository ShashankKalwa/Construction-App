<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:padding="@dimen/cms_spacing_lg">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/cms_spacing_md"
        android:background="@color/cms_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Storekeeper Stock Issuance"
        android:textAppearance="@style/TextAppearance.CMS.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Deduct inventory from warehouse and dispatch to site"
        android:textAppearance="@style/TextAppearance.CMS.Caption"
        android:textColor="@color/cms_text_tertiary" />

    <!-- Material Details Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        style="@style/Widget.CMS.Card.Elevated">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/cms_spacing_md">

            <TextView
                android:id="@+id/tvIssueMaterialName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CMS.Headline"
                tools:text="12mm TMT Fe550D Rebar" />

            <TextView
                android:id="@+id/tvIssueQuantity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.CMS.Body"
                android:textColor="@color/cms_accent"
                tools:text="Quantity to Issue: 5.00 MT" />

            <TextView
                android:id="@+id/tvCurrentAvailableStock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_secondary"
                tools:text="Current Available Stock: 14.50 MT" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Notes / Gate Pass / Delivery Challan -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilIssueNotes"
        style="@style/Widget.CMS.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:hint="Dispatch Notes / Gate Pass # / Vehicle #">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIssueNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:lines="2"
            android:textColor="@color/cms_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_lg"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.CMS.Button.Outlined"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/cms_spacing_sm"
            android:layout_weight="1"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmIssue"
            style="@style/Widget.CMS.Button.Primary"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Confirm Issuance" />
    </LinearLayout>

</LinearLayout>

