<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshAccountant"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cms_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/cms_spacing_lg"
            android:paddingTop="@dimen/cms_spacing_lg"
            android:paddingBottom="80dp">

            <!-- Accountant Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Financial Management,"
                        android:textAppearance="@style/TextAppearance.CMS.Caption"
                        android:textColor="@color/cms_text_secondary" />

                    <TextView
                        android:id="@+id/tvAccountantName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CMS.Headline"
                        android:textColor="@color/cms_text_primary"
                        tools:text="Sunita Roy" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_selected"
                            android:paddingHorizontal="@dimen/cms_spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="ACCOUNTANT"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_accent"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAccountantOrgName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cms_spacing_sm"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_text_secondary"
                            tools:text="Commercial Tower B" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnAccountantNotifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/cms_text_secondary" />

                <ImageButton
                    android:id="@+id/btnAccountantLogout"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/cms_spacing_xs"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Logout"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/cms_text_secondary" />
            </LinearLayout>

            <!-- Project Switcher Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardAccountantProjectSwitcher"
                style="@style/Widget.CMS.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_lg"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/cms_spacing_card">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Project"
                        android:src="@drawable/ic_building"
                        app:tint="@color/cms_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cms_spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FINANCIAL LEDGER SCOPE"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_accent" />

                        <TextView
                            android:id="@+id/tvAccountantActiveProject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CMS.Body"
                            android:textStyle="bold"
                            tools:text="CTB-02 • Commercial Tower B" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Switch"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/cms_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Budget & Spend Overview -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_xl"
                android:layout_marginBottom="@dimen/cms_spacing_sm"
                android:text="COST SUMMARY &amp; SPEND"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_secondary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CMS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/cms_spacing_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="SANCTIONED BUDGET"
                                android:textAppearance="@style/TextAppearance.CMS.Caption"
                                android:textColor="@color/cms_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹5,40,00,000"
                                android:textAppearance="@style/TextAppearance.CMS.Headline"
                                android:textColor="@color/cms_text_primary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="@dimen/cms_spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="-4.2% Variance"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_success" />
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginVertical="@dimen/cms_spacing_md"
                        android:background="@color/cms_divider" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="COMMITTED POs"
                                android:textAppearance="@style/TextAppearance.CMS.Caption"
                                android:textColor="@color/cms_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹3,12,00,000"
                                android:textAppearance="@style/TextAppearance.CMS.Body"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACTUAL PAID"
                                android:textAppearance="@style/TextAppearance.CMS.Caption"
                                android:textColor="@color/cms_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="₹1,85,50,000"
                                android:textAppearance="@style/TextAppearance.CMS.Body"
                                android:textColor="@color/cms_accent"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Pending Approvals & Bills -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_xl"
                android:layout_marginBottom="@dimen/cms_spacing_sm"
                android:text="PENDING EXPENSES &amp; BILLS"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_secondary" />

            <!-- Contractor RA Bill Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CMS.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/cms_spacing_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="CONTRACTOR RA BILL #4"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_warning" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="@dimen/cms_spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="PENDING DISBURSEMENT"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_warning" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cms_spacing_xs"
                        android:text="Royal Infra • 6th Floor Slab Casting"
                        android:textAppearance="@style/TextAppearance.CMS.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Gross: ₹4,85,000 | Retention (5%): ₹24,250 | TDS (2%): ₹9,700"
                        android:textAppearance="@style/TextAppearance.CMS.Caption"
                        android:textColor="@color/cms_text_secondary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cms_spacing_sm"
                        android:text="Net Payable: ₹4,51,050"
                        android:textAppearance="@style/TextAppearance.CMS.Body"
                        android:textColor="@color/cms_accent"
                        android:textStyle="bold" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
