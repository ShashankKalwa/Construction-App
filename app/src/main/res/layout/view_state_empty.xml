<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/emptyLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/cms_spacing_xl"
    android:visibility="gone">

    <TextView
        android:id="@+id/tvEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="No Items Found"
        android:textAppearance="@style/TextAppearance.CMS.Title" />

    <TextView
        android:id="@+id/tvEmptySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_xs"
        android:gravity="center"
        android:text="There are no items to display at this time."
        android:textAppearance="@style/TextAppearance.CMS.BodySecondary" />
</LinearLayout>
