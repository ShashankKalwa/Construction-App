<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/cms_card"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cms_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp"
        android:gravity="center_vertical">

        <FrameLayout
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_card_elevated">

            <ImageView
                android:id="@+id/ivSyncIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_sync"
                app:tint="@color/cms_accent" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvSyncTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cms_text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Daily Site Report (DSR)" />

            <TextView
                android:id="@+id/tvSyncSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/cms_text_secondary"
                android:textSize="12sp"
                tools:text="4th Floor Slab Concreting - Weather: Sunny" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvSyncStatusBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip_selected"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:textColor="@color/cms_warning"
            android:textSize="11sp"
            android:textStyle="bold"
            tools:text="Pending Sync" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
