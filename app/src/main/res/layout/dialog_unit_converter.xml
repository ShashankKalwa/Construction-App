<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cms_surface"
    android:orientation="vertical"
    android:padding="@dimen/cms_spacing_xl">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="RAPID SITE UTILITY"
        android:textAppearance="@style/TextAppearance.CMS.Caption"
        android:textColor="@color/cms_accent" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Construction Unit Converter"
        android:textAppearance="@style/TextAppearance.CMS.Headline" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupCategory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipLinear"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="Linear (m, ft, in)"
            android:textColor="@color/cms_text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipArea"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Area (m², sqft, brass)"
            android:textColor="@color/cms_text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipVolume"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume (m³, cft, brass)"
            android:textColor="@color/cms_text_primary" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipMass"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mass (kg, tonne, quintal)"
            android:textColor="@color/cms_text_primary" />
    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.textfield.TextInputLayout
        style="@style/Widget.CMS.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:hint="Value to convert">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etConvertValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:text="1.0"
            android:textColor="@color/cms_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_sm"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/cms_spacing_xs"
            android:layout_weight="1"
            android:hint="From Unit">

            <AutoCompleteTextView
                android:id="@+id/actvFromUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cms_spacing_xs"
            android:layout_weight="1"
            android:hint="To Unit">

            <AutoCompleteTextView
                android:id="@+id/actvToUnit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnConvertExecute"
        style="@style/Widget.CMS.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:text="CONVERT NOW" />

    <!-- Result Display Card -->
    <com.google.android.material.card.MaterialCardView
        style="@style/Widget.CMS.Card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/cms_spacing_card">

            <TextView
                android:id="@+id/tvConversionResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CMS.Title"
                android:textColor="@color/cms_accent"
                android:textStyle="bold"
                tools:text="1.00 m = 3.2808 ft" />

            <TextView
                android:id="@+id/tvConversionBreakdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_xs"
                android:textAppearance="@style/TextAppearance.CMS.BodySecondary"
                tools:text="All conversions: 1000.0 mm • 100.0 cm • 39.37 in • 1.0936 yd" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDismissConverter"
        style="@style/Widget.Material3.Button.TextButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_sm"
        android:text="CLOSE"
        android:textColor="@color/cms_text_secondary" />

</LinearLayout>
