<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPurchaseOrder"
    style="@style/Widget.CMS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cms_spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cms_spacing_card">

        <!-- Top Header: PO Number + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvPoNumber"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="@dimen/cms_spacing_sm"
                android:paddingVertical="@dimen/cms_spacing_xs"
                android:textAppearance="@style/TextAppearance.CMS.Mono"
                tools:text="PO-2026-0101" />

            <TextView
                android:id="@+id/tvOrderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cms_spacing_sm"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_tertiary"
                tools:text="01 Mar 2026" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvPoStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/cms_warning_tint"
                android:paddingHorizontal="@dimen/cms_spacing_sm"
                android:paddingVertical="3dp"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_warning"
                android:textStyle="bold"
                tools:text="ISSUED" />
        </LinearLayout>

        <!-- Vendor Name -->
        <TextView
            android:id="@+id/tvVendorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:textAppearance="@style/TextAppearance.CMS.Title"
            tools:text="UltraTech Cement Distribution Hub" />

        <!-- Total Amount & Delivery Deadline -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Commitment Value"
                    android:textAppearance="@style/TextAppearance.CMS.Caption"
                    android:textColor="@color/cms_text_secondary" />

                <TextView
                    android:id="@+id/tvTotalAmount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CMS.Headline"
                    android:textColor="@color/cms_text_primary"
                    tools:text="₹1,90,000" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delivery Deadline"
                    android:textAppearance="@style/TextAppearance.CMS.Caption"
                    android:textColor="@color/cms_text_secondary" />

                <TextView
                    android:id="@+id/tvDeadline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.CMS.Body"
                    android:textColor="@color/cms_accent"
                    tools:text="05 Mar 2026" />
            </LinearLayout>
        </LinearLayout>

        <!-- Line Items Summary -->
        <TextView
            android:id="@+id/tvItemsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:textAppearance="@style/TextAppearance.CMS.BodySecondary"
            tools:text="Items: 500 Bags OPC 53 Grade Cement (500 / 500 Bags received)" />

        <!-- Action Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_md"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordGrn"
                style="@style/Widget.CMS.Button.Primary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingHorizontal="@dimen/cms_spacing_md"
                android:text="Record GRN Inward"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

