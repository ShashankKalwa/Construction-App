<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:padding="@dimen/cms_spacing_lg">

    <!-- Handle Bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/cms_spacing_md"
        android:background="@color/cms_border" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Add Approved Vendor"
        android:textAppearance="@style/TextAppearance.CMS.Title" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Register suppliers and contractors for procurement &amp; billing"
        android:textAppearance="@style/TextAppearance.CMS.Caption"
        android:textColor="@color/cms_text_tertiary" />

    <!-- Vendor Name -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilVendorName"
        style="@style/Widget.CMS.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:hint="Vendor / Company Name *">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVendorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapWords"
            android:textColor="@color/cms_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Category Dropdown -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilVendorCategory"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:hint="Category *">

        <AutoCompleteTextView
            android:id="@+id/actvVendorCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/cms_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Contact Person & Phone (Side by side) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilContactPerson"
            style="@style/Widget.CMS.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Contact Person">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etContactPerson"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="@dimen/cms_spacing_sm"
            android:layout_height="1dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilPhone"
            style="@style/Widget.CMS.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Phone">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etPhone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- GSTIN & Email (Side by side) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilGstin"
            style="@style/Widget.CMS.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="GSTIN (15 Digits)">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etGstin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:maxLength="15"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <View
            android:layout_width="@dimen/cms_spacing_sm"
            android:layout_height="1dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilEmail"
            style="@style/Widget.CMS.TextInputLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Email">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textEmailAddress"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <!-- Payment Terms -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPaymentTerms"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_md"
        android:hint="Payment Terms">

        <AutoCompleteTextView
            android:id="@+id/actvPaymentTerms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="none"
            android:textColor="@color/cms_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/cms_spacing_lg"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/cms_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitVendor"
            style="@style/Widget.CMS.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/cms_spacing_sm"
            android:text="Save Vendor" />
    </LinearLayout>

</LinearLayout>

