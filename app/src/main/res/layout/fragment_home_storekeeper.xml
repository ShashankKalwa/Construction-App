<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshStorekeeper"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cms_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/cms_spacing_lg"
            android:paddingTop="@dimen/cms_spacing_lg"
            android:paddingBottom="80dp">

            <!-- Storekeeper Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Site Inventory &amp; Stock,"
                        android:textAppearance="@style/TextAppearance.CMS.Caption"
                        android:textColor="@color/cms_text_secondary" />

                    <TextView
                        android:id="@+id/tvStorekeeperName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CMS.Headline"
                        android:textColor="@color/cms_text_primary"
                        tools:text="Ramesh Yadav" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_selected"
                            android:paddingHorizontal="@dimen/cms_spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="STOREKEEPER"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_accent"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvStorekeeperOrgName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cms_spacing_sm"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_text_secondary"
                            tools:text="Commercial Tower B Depot" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnStorekeeperNotifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/cms_text_secondary" />

                <ImageButton
                    android:id="@+id/btnStorekeeperLogout"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/cms_spacing_xs"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Logout"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/cms_text_secondary" />
            </LinearLayout>

            <!-- Active Project / Depot Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardStorekeeperProjectSwitcher"
                style="@style/Widget.CMS.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_lg"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/cms_spacing_card">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Depot"
                        android:src="@drawable/ic_building"
                        app:tint="@color/cms_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cms_spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="SITE STOCK LOCATION"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_accent" />

                        <TextView
                            android:id="@+id/tvStorekeeperActiveProject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CMS.Body"
                            android:textStyle="bold"
                            tools:text="CTB-02 • Commercial Tower B" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Switch"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/cms_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Low Stock Critical Alert Banner -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CMS.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_md"
                app:strokeColor="@color/cms_error">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/cms_spacing_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Warning"
                            android:src="@drawable/ic_warning"
                            app:tint="@color/cms_error" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cms_spacing_sm"
                            android:layout_weight="1"
                            android:text="LOW STOCK ALERT"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_error"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="@dimen/cms_spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="REORDER"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_error" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cms_spacing_xs"
                        android:text="UltraTech OPC 53 Grade Cement"
                        android:textAppearance="@style/TextAppearance.CMS.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Current stock is 85 Bags. Minimum reorder safety threshold is 100 Bags."
                        android:textAppearance="@style/TextAppearance.CMS.Caption"
                        android:textColor="@color/cms_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Store Inventory KPIs -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_xl"
                android:layout_marginBottom="@dimen/cms_spacing_sm"
                android:text="INVENTORY REQUISITION STATUS"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CMS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/cms_spacing_sm"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cms_spacing_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INCOMING (GRN)"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="2 Expected"
                            android:textAppearance="@style/TextAppearance.CMS.Headline"
                            android:textColor="@color/cms_text_primary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Deliveries Today"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_success" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    style="@style/Widget.CMS.Card"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cms_spacing_sm"
                    android:layout_weight="1">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/cms_spacing_card">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TO ISSUE"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_text_secondary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="1 Requisition"
                            android:textAppearance="@style/TextAppearance.CMS.Headline"
                            android:textColor="@color/cms_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Approved &amp; Ready"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_warning" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
