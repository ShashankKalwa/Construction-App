<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardMilestone"
    style="@style/Widget.CMS.Card.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/cms_spacing_xs"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cms_spacing_card">

        <!-- Top Row: Target Pct + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMilestoneTargetPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CMS.Mono"
                android:textColor="@color/cms_accent"
                tools:text="Target: 50%" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvMilestoneStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="@dimen/cms_spacing_sm"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textStyle="bold"
                tools:text="REACHED" />
        </LinearLayout>

        <!-- Title -->
        <TextView
            android:id="@+id/tvMilestoneTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_xs"
            android:textAppearance="@style/TextAppearance.CMS.Body"
            android:textStyle="bold"
            tools:text="Foundation and Substructure Completion" />

        <!-- Due Date & Action hint -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMilestoneDueDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_secondary"
                tools:text="Target Date: 15 Mar 2026" />

            <TextView
                android:id="@+id/tvMilestoneActionHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tap to update status"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_tertiary" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
