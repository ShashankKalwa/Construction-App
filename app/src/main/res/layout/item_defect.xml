<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/cms_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/cms_surface_bright"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDefectSeverityBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_unselected"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="CRITICAL"
                android:textColor="@color/cms_error"
                android:textSize="11sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvDefectStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="OPEN"
                android:textColor="@color/cms_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDefectTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Missing edge guardrails on Level 1 east face"
            android:textColor="@color/cms_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDefectDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:lineSpacingExtra="2dp"
            android:text="East elevation edge lacks top and mid guardrails. High fall hazard for slab staging crew."
            android:textColor="@color/cms_text_secondary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvDefectLocationDeadline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="📍 Level 1 East Perimeter • ⏰ Deadline: 05 Mar 2026"
            android:textColor="@color/cms_text_tertiary"
            android:textSize="12sp" />

        <!-- Re-inspection / Resolution Notes Banner -->
        <LinearLayout
            android:id="@+id/layoutReinspectionNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvReinspectionNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="QC Re-inspection: Fixed and approved."
                android:textColor="@color/cms_success"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvDefectAssigneeMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Assigned: Safety Officer"
                android:textColor="@color/cms_text_tertiary"
                android:textSize="11sp" />

            <!-- Primary Action Button: Resolve or Re-inspect -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDefectAction"
                style="@style/Widget.CMS.Button.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:paddingHorizontal="12dp"
                android:text="Mark Resolved"
                android:textSize="11sp"
                android:visibility="visible" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
