<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cms_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/cms_spacing_section"
        android:paddingVertical="@dimen/cms_spacing_xxl">

        <!-- Logo / Icon -->
        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="Apex Infra Logo"
            android:src="@drawable/ic_building"
            app:tint="@color/cms_accent" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_lg"
            android:text="APEX INFRA"
            android:textAppearance="@style/TextAppearance.CMS.Display"
            android:textColor="@color/cms_text_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.15"
            android:text="INDUSTRIAL CONSOLE OS • V1.0"
            android:textAppearance="@style/TextAppearance.CMS.Caption"
            android:textColor="@color/cms_accent" />

        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.CMS.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_xxl">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/cms_spacing_xl">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Operator Role"
                    android:textAppearance="@style/TextAppearance.CMS.Title" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cms_spacing_xs"
                    android:text="Choose your role to load permission scope"
                    android:textAppearance="@style/TextAppearance.CMS.BodySecondary" />

                <!-- Role Dropdown Spinner -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRole"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cms_spacing_lg"
                    android:hint="Role">

                    <AutoCompleteTextView
                        android:id="@+id/actvRole"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="none"
                        android:textColor="@color/cms_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Email Input -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    style="@style/Widget.CMS.TextInputLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cms_spacing_md"
                    android:hint="Email Address">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="@color/cms_text_primary" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Sign In Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignIn"
                    style="@style/Widget.CMS.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cms_spacing_xl"
                    android:text="SIGN IN TO CONSOLE" />

                <!-- Component Gallery Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnOpenGallery"
                    style="@style/Widget.CMS.Button.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/cms_spacing_sm"
                    android:text="Debug: Component Gallery" />

                <ProgressBar
                    android:id="@+id/progressBarLogin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="@dimen/cms_spacing_md"
                    android:indeterminateTint="@color/cms_accent"
                    android:visibility="gone" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
