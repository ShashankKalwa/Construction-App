<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshSupervisor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cms_background">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/cms_spacing_lg"
            android:paddingTop="@dimen/cms_spacing_lg"
            android:paddingBottom="80dp">

            <!-- Supervisor Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="On-Site Operations,"
                        android:textAppearance="@style/TextAppearance.CMS.Caption"
                        android:textColor="@color/cms_text_secondary" />

                    <TextView
                        android:id="@+id/tvSupervisorName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.CMS.Headline"
                        android:textColor="@color/cms_text_primary"
                        tools:text="Shashank Kumar" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_selected"
                            android:paddingHorizontal="@dimen/cms_spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="SITE SUPERVISOR"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_accent"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSupervisorOrgName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/cms_spacing_sm"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_text_secondary"
                            tools:text="Commercial Tower B" />
                    </LinearLayout>
                </LinearLayout>

                <ImageButton
                    android:id="@+id/btnSupervisorNotifications"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Notifications"
                    android:src="@drawable/ic_bell"
                    app:tint="@color/cms_text_secondary" />

                <ImageButton
                    android:id="@+id/btnSupervisorLogout"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="@dimen/cms_spacing_xs"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Logout"
                    android:src="@drawable/ic_logout"
                    app:tint="@color/cms_text_secondary" />
            </LinearLayout>

            <!-- Project Switcher Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSupervisorProjectSwitcher"
                style="@style/Widget.CMS.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_lg"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/cms_spacing_card">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:contentDescription="Site"
                        android:src="@drawable/ic_building"
                        app:tint="@color/cms_accent" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/cms_spacing_md"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ACTIVE SITE LOCATION"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_accent" />

                        <TextView
                            android:id="@+id/tvSupervisorActiveProject"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textAppearance="@style/TextAppearance.CMS.Body"
                            android:textStyle="bold"
                            tools:text="CTB-02 • Commercial Tower B" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="Switch"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/cms_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Daily Site Diary Priority Action Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CMS.Card.Elevated"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_md">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/cms_spacing_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="TODAY'S SITE DIARY"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_warning" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_status_badge"
                            android:paddingHorizontal="@dimen/cms_spacing_sm"
                            android:paddingVertical="2dp"
                            android:text="DUE TODAY"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_warning" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cms_spacing_xs"
                        android:text="Daily Field Report Pending"
                        android:textAppearance="@style/TextAppearance.CMS.Title" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Record weather conditions, major progress milestones, and daily activity narrative."
                        android:textAppearance="@style/TextAppearance.CMS.Caption"
                        android:textColor="@color/cms_text_secondary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSubmitDsr"
                        style="@style/Widget.CMS.Button.Primary"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="@dimen/cms_spacing_md"
                        android:text="SUBMIT DAILY REPORT" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Today's Labor Headcount Card -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_xl"
                android:layout_marginBottom="@dimen/cms_spacing_sm"
                android:text="ON-SITE LABOR HEADCOUNT"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_secondary" />

            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.CMS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/cms_spacing_card">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="TOTAL ON SITE"
                                android:textAppearance="@style/TextAppearance.CMS.Caption"
                                android:textColor="@color/cms_text_secondary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="36 Workers"
                                android:textAppearance="@style/TextAppearance.CMS.Headline"
                                android:textColor="@color/cms_text_primary" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_chip_selected"
                            android:paddingHorizontal="@dimen/cms_spacing_sm"
                            android:paddingVertical="4dp"
                            android:text="3 Contractors"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_accent"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/cms_spacing_sm"
                        android:text="8 Carpenters (Apex Formwork) • 12 Barbenders (Shree Steel) • 16 Helpers"
                        android:textAppearance="@style/TextAppearance.CMS.Caption"
                        android:textColor="@color/cms_text_secondary" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Supervisor Field Quick Actions -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_xl"
                android:layout_marginBottom="@dimen/cms_spacing_sm"
                android:text="FIELD ACTIONS"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_secondary" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSupervisorRequestMaterial"
                    style="@style/Widget.CMS.Card.Elevated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/cms_spacing_sm"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/cms_spacing_card">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="Materials"
                            android:src="@drawable/ic_tasks"
                            app:tint="@color/cms_accent" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cms_spacing_xs"
                            android:text="Material Indent"
                            android:textAppearance="@style/TextAppearance.CMS.Body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Requisition"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardSupervisorRecordExpense"
                    style="@style/Widget.CMS.Card.Elevated"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cms_spacing_sm"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/cms_spacing_card">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:contentDescription="Expense"
                            android:src="@drawable/ic_plus"
                            app:tint="@color/cms_warning" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/cms_spacing_xs"
                            android:text="Site Expense"
                            android:textAppearance="@style/TextAppearance.CMS.Body"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Petty Cash"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_text_secondary" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
