<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cms_background">

    <!-- ViewPager2 for seamless switching between Home, Projects, Tasks, Tools -->
    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/viewPagerShell"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="68dp" />

    <!-- Bottom Navigation Bar directly in CoordinatorLayout -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@color/cms_surface"
        app:elevation="8dp"
        app:itemIconTint="@color/bottom_nav_color_selector"
        app:itemTextColor="@color/bottom_nav_color_selector"
        app:labelVisibilityMode="labeled"
        app:menu="@menu/bottom_nav_menu" />

    <!-- Floating Action Button for Quick Actions centered above bottom navigation -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabQuickAction"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/cms_accent"
        android:contentDescription="Quick Action"
        android:src="@drawable/ic_plus"
        app:borderWidth="0dp"
        app:elevation="12dp"
        app:layout_anchor="@id/bottomNavView"
        app:layout_anchorGravity="top|center_horizontal"
        app:tint="@color/cms_accent_on" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
