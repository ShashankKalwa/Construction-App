<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardStockMovement"
    style="@style/Widget.CMS.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/cms_spacing_md">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cms_spacing_card">

        <!-- Top Header: Movement Type Badge + Timestamp -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMovementBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:backgroundTint="@color/cms_success_tint"
                android:paddingHorizontal="@dimen/cms_spacing_sm"
                android:paddingVertical="3dp"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_success"
                android:textStyle="bold"
                tools:text="INWARD (GRN)" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvMovementDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_tertiary"
                tools:text="19 Mar 2026, 09:15" />
        </LinearLayout>

        <!-- Material Name & Quantity Change -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvMaterialName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.CMS.Title"
                tools:text="OPC 53 Grade Cement" />

            <TextView
                android:id="@+id/tvQuantityChange"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CMS.Headline"
                android:textColor="@color/cms_success"
                tools:text="+500.00" />
        </LinearLayout>

        <!-- Balance After & Reference ID -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_xs"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvBalanceAfter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="@style/TextAppearance.CMS.BodySecondary"
                tools:text="Balance after: 500.00 Bags" />

            <TextView
                android:id="@+id/tvReferenceId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="@dimen/cms_spacing_xs"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.CMS.Mono"
                android:textSize="11sp"
                tools:text="PO-2026-001" />
        </LinearLayout>

        <!-- Notes and Performed By -->
        <TextView
            android:id="@+id/tvNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_xs"
            android:textAppearance="@style/TextAppearance.CMS.Caption"
            android:textColor="@color/cms_text_secondary"
            tools:text="Notes: Initial cement consignment via Challan #4481" />

        <TextView
            android:id="@+id/tvPerformedBy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.CMS.Caption"
            android:textColor="@color/cms_text_tertiary"
            tools:text="By Ramesh Yadav (Storekeeper)" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

