<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_navigation">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cms_spacing_xl">

        <!-- Drag handle -->
        <View
            android:layout_width="36dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/cms_spacing_lg"
            android:background="@drawable/bg_status_badge" />

        <TextView
            android:id="@+id/tvSheetTaskCode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="@style/TextAppearance.CMS.Mono"
            tools:text="TSK-001" />

        <TextView
            android:id="@+id/tvSheetTaskTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.CMS.Title"
            tools:text="Excavation and Soil Stabilization" />

        <!-- Progress Slider Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_lg"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Completion Progress"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_text_tertiary" />

            <TextView
                android:id="@+id/tvSliderValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CMS.Headline"
                android:textColor="@color/cms_accent"
                tools:text="75%" />
        </LinearLayout>

        <com.google.android.material.slider.Slider
            android:id="@+id/sliderProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_xs"
            android:stepSize="5"
            android:value="0"
            android:valueFrom="0"
            android:valueTo="100"
            app:thumbColor="@color/cms_accent"
            app:trackColorActive="@color/cms_accent"
            app:trackColorInactive="@color/cms_card_elevated" />

        <!-- Status Selection -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_md"
            android:text="Task Status"
            android:textAppearance="@style/TextAppearance.CMS.Caption"
            android:textColor="@color/cms_text_tertiary" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_xs"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupStatusUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusPending"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="PENDING"
                    app:chipBackgroundColor="@color/cms_card_elevated" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusInProgress"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IN_PROGRESS"
                    app:chipBackgroundColor="@color/cms_card_elevated" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusBlocked"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="BLOCKED"
                    app:chipBackgroundColor="@color/cms_card_elevated" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStatusCompleted"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="COMPLETED"
                    app:chipBackgroundColor="@color/cms_card_elevated" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveTaskUpdate"
            style="@style/Widget.CMS.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_lg"
            android:text="UPDATE PROGRESS" />

        <!-- Review Workflow Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="@dimen/cms_spacing_lg"
            android:background="@color/cms_divider" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REVIEW WORKFLOW"
            android:textAppearance="@style/TextAppearance.CMS.Caption"
            android:textColor="@color/cms_accent" />

        <!-- Submit for Review Container -->
        <LinearLayout
            android:id="@+id/layoutSubmitReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:orientation="vertical">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSubmissionNotes"
                style="@style/Widget.CMS.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Submission notes (optional)">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etSubmissionNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:lines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSubmitReview"
                style="@style/Widget.CMS.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_sm"
                android:text="SUBMIT FOR APPROVAL" />
        </LinearLayout>

        <!-- Review Decision Container (for reviewers or when in review) -->
        <LinearLayout
            android:id="@+id/layoutReviewDecision"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSelfReviewWarning"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:padding="@dimen/cms_spacing_sm"
                android:text="⚠️ Self-approval restricted: Assignees cannot review their own submitted tasks."
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_warning"
                android:visibility="gone" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilReviewNotes"
                style="@style/Widget.CMS.TextInputLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_sm"
                android:hint="Review comments / correction details">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etReviewNotes"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textMultiLine"
                    android:lines="2" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@+id/layoutDecisionButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/cms_spacing_sm"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRejectTask"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/cms_spacing_xs"
                    android:layout_weight="1"
                    android:text="CORRECTIONS"
                    android:textColor="@color/cms_error" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnApproveTask"
                    style="@style/Widget.CMS.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/cms_spacing_xs"
                    android:layout_weight="1"
                    android:text="APPROVE" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressUpdateTask"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/cms_spacing_md"
            android:indeterminateTint="@color/cms_accent"
            android:visibility="gone" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
