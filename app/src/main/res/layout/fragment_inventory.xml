<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cms_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cms_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/cms_text_primary"
            app:title="Inventory &amp; Materials"
            app:titleTextAppearance="@style/TextAppearance.CMS.Title"
            app:titleTextColor="@color/cms_text_primary" />

        <!-- Category Filter Chips -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/cms_spacing_md"
            android:paddingBottom="@dimen/cms_spacing_sm"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chipGroupCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAll"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="All"
                    android:textColor="@color/cms_text_primary"
                    app:chipBackgroundColor="@color/cms_card"
                    app:chipStrokeColor="@color/cms_border" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipCement"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cement"
                    android:textColor="@color/cms_text_primary"
                    app:chipBackgroundColor="@color/cms_card"
                    app:chipStrokeColor="@color/cms_border" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSteel"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Steel"
                    android:textColor="@color/cms_text_primary"
                    app:chipBackgroundColor="@color/cms_card"
                    app:chipStrokeColor="@color/cms_border" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipAggregate"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Aggregates"
                    android:textColor="@color/cms_text_primary"
                    app:chipBackgroundColor="@color/cms_card"
                    app:chipStrokeColor="@color/cms_border" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipMasonry"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Masonry"
                    android:textColor="@color/cms_text_primary"
                    app:chipBackgroundColor="@color/cms_card"
                    app:chipStrokeColor="@color/cms_border" />
            </com.google.android.material.chip.ChipGroup>
        </HorizontalScrollView>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Materials List -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMaterials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/cms_spacing_md"
            android:paddingBottom="88dp"
            tools:listitem="@layout/item_material_card" />

        <include
            android:id="@+id/emptyState"
            layout="@layout/view_state_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/loadingState"
            layout="@layout/view_state_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- FAB: Add Material / Request Material -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabRequestMaterial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/cms_spacing_lg"
        android:backgroundTint="@color/cms_accent"
        android:text="Request Material"
        android:textColor="@color/cms_accent_on"
        app:icon="@drawable/ic_plus"
        app:iconTint="@color/cms_accent_on" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
