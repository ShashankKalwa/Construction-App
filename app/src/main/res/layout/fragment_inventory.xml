<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cms_background">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/cms_surface">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/cms_text_primary"
            app:title="Inventory &amp; Materials"
            app:titleTextAppearance="@style/TextAppearance.CMS.Title"
            app:titleTextColor="@color/cms_text_primary" />

        <!-- 3 Tabs: Stock & Catalog, Requests, Stock Ledger -->
        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutInventory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cms_surface"
            app:tabIndicatorColor="@color/cms_accent"
            app:tabIndicatorHeight="3dp"
            app:tabMode="fixed"
            app:tabSelectedTextColor="@color/cms_accent"
            app:tabTextColor="@color/cms_text_secondary">

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stock" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requests" />

            <com.google.android.material.tabs.TabItem
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Ledger" />
        </com.google.android.material.tabs.TabLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- =================================================================== -->
        <!-- TAB 0: Stock & Catalog View -->
        <!-- =================================================================== -->
        <LinearLayout
            android:id="@+id/layoutStockTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- Low Stock Warning Banner -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLowStockAlert"
                style="@style/Widget.CMS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/cms_spacing_md"
                android:layout_marginTop="@dimen/cms_spacing_sm"
                android:backgroundTint="@color/cms_warning_tint"
                app:strokeColor="@color/cms_warning"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/cms_spacing_md">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginEnd="@dimen/cms_spacing_sm"
                        android:src="@drawable/ic_warning"
                        app:tint="@color/cms_warning" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Low Stock Safety Threshold Alert"
                            android:textAppearance="@style/TextAppearance.CMS.Body"
                            android:textColor="@color/cms_warning"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvLowStockAlertDetails"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:textAppearance="@style/TextAppearance.CMS.Caption"
                            android:textColor="@color/cms_text_primary"
                            tools:text="12mm TMT Fe550D Rebar is below minimum threshold (3.50 MT &lt; 6.00 MT)" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/cms_spacing_md"
                android:paddingVertical="@dimen/cms_spacing_xs"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="All"
                        android:textColor="@color/cms_text_primary"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCement"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Cement"
                        android:textColor="@color/cms_text_primary"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSteel"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Steel"
                        android:textColor="@color/cms_text_primary"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAggregate"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Aggregates"
                        android:textColor="@color/cms_text_primary"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipMasonry"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Masonry"
                        android:textColor="@color/cms_text_primary"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <!-- Materials List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMaterials"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="@dimen/cms_spacing_md"
                android:paddingBottom="88dp"
                tools:listitem="@layout/item_material_card" />
        </LinearLayout>

        <!-- =================================================================== -->
        <!-- TAB 1: Material Requests (MRN) View -->
        <!-- =================================================================== -->
        <LinearLayout
            android:id="@+id/layoutRequestsTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Request Status Filter Chips -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/cms_spacing_md"
                android:paddingVertical="@dimen/cms_spacing_xs"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRequestStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleLine="true"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqAll"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="All"
                        android:textColor="@color/cms_text_primary"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqPending"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Pending"
                        android:textColor="@color/cms_warning"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqApproved"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Approved"
                        android:textColor="@color/cms_info"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqIssued"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Issued"
                        android:textColor="@color/cms_success"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipReqRejected"
                        style="@style/Widget.Material3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Rejected"
                        android:textColor="@color/cms_error"
                        app:chipBackgroundColor="@color/cms_card"
                        app:chipStrokeColor="@color/cms_border" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvMaterialRequests"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:padding="@dimen/cms_spacing_md"
                android:paddingBottom="88dp"
                tools:listitem="@layout/item_material_request" />
        </LinearLayout>

        <!-- =================================================================== -->
        <!-- TAB 2: Stock Ledger View -->
        <!-- =================================================================== -->
        <LinearLayout
            android:id="@+id/layoutLedgerTab"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvStockLedger"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:padding="@dimen/cms_spacing_md"
                tools:listitem="@layout/item_stock_ledger" />
        </LinearLayout>

        <!-- Shared Loading and Empty States -->
        <include
            android:id="@+id/emptyState"
            layout="@layout/view_state_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <include
            android:id="@+id/loadingState"
            layout="@layout/view_state_loading"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />
    </FrameLayout>

    <!-- FAB: Request Material -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabRequestMaterial"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="@dimen/cms_spacing_lg"
        android:backgroundTint="@color/cms_accent"
        android:text="Request Material"
        android:textColor="@color/cms_accent_on"
        app:icon="@drawable/ic_plus"
        app:iconTint="@color/cms_accent_on" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
