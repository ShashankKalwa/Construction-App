<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardTask"
    style="@style/Widget.CMS.Card.Elevated"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/cms_spacing_xs"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/cms_spacing_card">

        <!-- Top row: Code + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTaskCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.CMS.Mono"
                android:textColor="@color/cms_text_secondary"
                tools:text="TSK-001" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <TextView
                android:id="@+id/tvTaskStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_status_badge"
                android:paddingHorizontal="@dimen/cms_spacing_sm"
                android:paddingVertical="2dp"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textStyle="bold"
                tools:text="IN_PROGRESS" />
        </LinearLayout>

        <!-- Task Title -->
        <TextView
            android:id="@+id/tvTaskName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_xs"
            android:textAppearance="@style/TextAppearance.CMS.Body"
            android:textStyle="bold"
            tools:text="Excavation and Soil Stabilization" />

        <!-- Assignee & Trade -->
        <TextView
            android:id="@+id/tvTaskSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textAppearance="@style/TextAppearance.CMS.Caption"
            tools:text="Assignee: Anand Verma • Civil Work" />

        <!-- Progress Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/cms_spacing_sm"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressTask"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:indicatorColor="@color/cms_accent"
                app:trackColor="@color/cms_card"
                app:trackCornerRadius="@dimen/cms_radius_pill"
                app:trackThickness="@dimen/cms_stroke_progress"
                tools:progress="70" />

            <TextView
                android:id="@+id/tvTaskProgressPct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/cms_spacing_sm"
                android:textAppearance="@style/TextAppearance.CMS.Caption"
                android:textColor="@color/cms_accent"
                android:textStyle="bold"
                tools:text="70%" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
