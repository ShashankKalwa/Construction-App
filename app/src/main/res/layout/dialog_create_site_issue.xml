<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Report Site Issue / Snag"
        android:textColor="@color/cms_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Safety, quality defect, or site obstruction"
        android:textColor="@color/cms_text_secondary"
        android:textSize="12sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilIssueTitle"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Issue Summary"
        app:boxStrokeColor="@color/cms_accent"
        app:hintTextColor="@color/cms_accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIssueTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textCapSentences"
            android:text="Honeycombing observed in footing pedestal"
            android:textColor="@color/cms_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIssueSeverity"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:hint="Severity"
            app:boxStrokeColor="@color/cms_accent"
            app:hintTextColor="@color/cms_accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIssueSeverity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapCharacters"
                android:text="HIGH"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilIssueAssignedTo"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Assign To"
            app:boxStrokeColor="@color/cms_accent"
            app:hintTextColor="@color/cms_accent">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etIssueAssignedTo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Site Engineer"
                android:textColor="@color/cms_text_primary" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilIssueDescription"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Detailed Description &amp; Root Cause"
        app:boxStrokeColor="@color/cms_accent"
        app:hintTextColor="@color/cms_accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etIssueDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:text="Inadequate needle vibration during pour led to surface voids. Non-shrink structural grout repair needed."
            android:textColor="@color/cms_text_primary" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelIssue"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/cms_text_secondary" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveIssue"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="@color/cms_accent"
            android:text="Report Issue"
            android:textColor="@color/cms_background"
            android:textStyle="bold"
            app:cornerRadius="8dp" />
    </LinearLayout>

</LinearLayout>
