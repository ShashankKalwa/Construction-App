<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cms_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvVerifyProgressTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Verify Physical Quantity"
        android:textColor="@color/cms_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Dual Control Notice -->
    <TextView
        android:id="@+id/tvDualControlNotice"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_card"
        android:lineSpacingExtra="2dp"
        android:padding="10dp"
        android:text="Dual-Control Rule: Verifier must be a Project Manager or Civil Engineer and cannot be the reporting supervisor."
        android:textColor="@color/cms_accent"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/tvItemSummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="RCC Column Pouring: Planned 50 m³ | Reported 42 m³"
        android:textColor="@color/cms_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilVerifiedQty"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Verified Physical Quantity"
        android:textColorHint="@color/cms_text_tertiary"
        app:boxStrokeColor="@color/cms_accent"
        app:hintTextColor="@color/cms_accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVerifiedQty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="numberDecimal"
            android:textColor="@color/cms_text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilVerificationNotes"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="Verification Notes (e.g. deductions, checks)"
        android:textColorHint="@color/cms_text_tertiary"
        app:boxStrokeColor="@color/cms_accent"
        app:hintTextColor="@color/cms_accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etVerificationNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:lines="2"
            android:textColor="@color/cms_text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRejectProgress"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Reject"
            android:textColor="@color/cms_error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnConfirmVerify"
            style="@style/Widget.CMS.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Verify &amp; Confirm" />
    </LinearLayout>

</LinearLayout>
