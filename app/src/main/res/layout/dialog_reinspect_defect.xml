<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/cms_surface"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QC Defect Re-Inspection"
        android:textColor="@color/cms_text_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Verify rectification before closing snag or reject to reopen"
        android:textColor="@color/cms_text_tertiary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvDefectTitlePreview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card"
        android:lineSpacingExtra="2dp"
        android:padding="10dp"
        android:text="Missing edge guardrails on Level 1 east face"
        android:textColor="@color/cms_text_secondary"
        android:textSize="13sp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilReinspectionNotes"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="Re-Inspection Findings &amp; Verification Notes"
        android:textColorHint="@color/cms_text_tertiary"
        app:boxStrokeColor="@color/cms_accent"
        app:hintTextColor="@color/cms_accent">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etReinspectionNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="top|start"
            android:inputType="textMultiLine"
            android:lines="3"
            android:textColor="@color/cms_text_primary"
            android:textSize="14sp" />
    </com.google.android.material.textfield.TextInputLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRejectReopen"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Reject &amp; Re-open"
            android:textColor="@color/cms_error" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnApproveClose"
            style="@style/Widget.CMS.Button.Primary"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:text="Approve &amp; Close" />
    </LinearLayout>

</LinearLayout>
