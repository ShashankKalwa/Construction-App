<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/cms_card"
    app:cardCornerRadius="20dp"
    app:strokeColor="@color/cms_border"
    app:strokeWidth="1dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_card_elevated">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_document"
                    app:tint="@color/cms_accent" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvDocumentTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/cms_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Architectural Layout - Typical Floor Plan" />

                <TextView
                    android:id="@+id/tvDocumentType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/cms_text_secondary"
                    android:textSize="12sp"
                    tools:text="Architectural Drawing • Drawings" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvVersionBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_chip_selected"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/cms_accent"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="v2.1" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="12dp"
            android:background="@color/cms_divider" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvFileMeta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/cms_text_tertiary"
                android:textSize="12sp"
                tools:text="17.3 MB • Updated 2 days ago" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewHistory"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:paddingHorizontal="8dp"
                android:text="History"
                android:textColor="@color/cms_text_secondary"
                android:textSize="12sp"
                app:icon="@drawable/ic_history"
                app:iconSize="14dp"
                app:iconTint="@color/cms_text_secondary" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnAddRevision"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:text="+ Rev"
                android:textColor="@color/cms_accent"
                android:textSize="12sp"
                app:backgroundTint="@color/cms_accent_tint" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
